# ─────────────────────────────────────────────────────────────────────────────
# Heritage of Faith — TanStack Start Web Environment Variables
# Copy this file to `.env` or `.env.development` for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Internal URL where TanStack Start SSR & Vite dev proxy reach the NestJS API
API_URL=http://localhost:3001

# Public application name exposed to client bundles
VITE_APP_NAME="Heritage Of Faith Membership Management Console"
