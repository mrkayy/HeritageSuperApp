# ─────────────────────────────────────────────────────────────────────────────
# Heritage of Faith — Single-Church API Environment Variables
# Copy this file to `.env` or `.env.development` for local development.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP Server Port
PORT=3001

# PostgreSQL Connection URL (Pooled URL recommended for runtime/serverless on Neon)
DATABASE_URL=postgresql://heritage:heritage@localhost:5433/heritage
# Optional non-pooled direct connection URL for Prisma CLI migrations (`npx prisma migrate deploy`)
DIRECT_URL=postgresql://heritage:heritage@localhost:5433/heritage

# Public URL of the TanStack Start Web App (used to construct links in emails)
WEB_URL=http://localhost:3000

# Comma-separated list of allowed origins for CORS & CSRF cookie mutation checks
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Session Cookie & Expiry Configuration
SESSION_COOKIE_NAME=hof_session
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24

# Invitation & Magic Link Token Lifetimes
CLAIM_TOKEN_TTL_HOURS=72
MAGIC_LINK_TTL_MINUTES=15

# Resend Email Provider Configuration
# Leave RESEND_API_KEY empty in development to log emails & claim links to console.
# In production, RESEND_API_KEY is required (e.g. re_123456789...).
RESEND_API_KEY=
EMAIL_FROM="support@heritagemmc.site"

# Initial Bootstrap Admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=securesuperadmin@heritagemmc.site
SEED_ADMIN_PASSWORD="$SecureSuperHMMCAdmin2026"
SEED_ADMIN_FIRST_NAME=Super
SEED_ADMIN_LAST_NAME=Admin
