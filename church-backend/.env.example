# Heritage SuperApp Backend V2 Configuration Example

# Runtime API Database (Restricted role: hof_v2_runtime)
export V2_DATABASE_URL="postgres://hof_v2_runtime:hof_v2_runtime_dev@127.0.0.1:5433/hof_v2_dev?sslmode=disable"

# Migration / DDL Database Owner (Owner role: hof_v2_user)
export V2_OWNER_DATABASE_URL="postgres://hof_v2_user:hof_v2_pass@127.0.0.1:5433/hof_v2_dev?sslmode=disable"

# Server Port & Environment
export V2_PORT="8081"
export V2_ENVIRONMENT="development"
export V2_LOG_LEVEL="info"
export V2_SESSION_COOKIE_NAME="hof_v2_session"
export V2_COOKIE_SECURE="false"

# Frontend Integration
export FRONTEND_URL="http://localhost:5173"

# Google OAuth2 Configuration (V2 auth linking)
export GOOGLE_CLIENT_ID="your-google-client-id"
export GOOGLE_CLIENT_SECRET="your-google-client-secret"
export GOOGLE_CALLBACK_URL="http://localhost:8081/api/v2/auth/callback/google"

# Email / SMTP Outbox Configuration
export SMTP_HOST="smtp.example.com"
export SMTP_PORT="587"
export SMTP_USER="notifications@example.com"
export SMTP_PASS="secret"
export SMTP_FROM_EMAIL="no-reply@heritagemmc.com"
export SMTP_FROM_NAME="Heritage MMC"
