########################################
### Auth Module - Super Admin Login
########################################
# Seeded Super Admin credentials:
# Email: admin@hofchurch.org
# Password: Password123@
#
# @name loginSuperAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@hofchurch.org",
  "password": "Password123@"
}

########################################
### Auth Module - Get Current User Info
########################################
# @name getMe
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}
Accept: application/json

########################################
### Profile Module - Get Own Profile
########################################
# @name getMyProfile
GET {{baseUrl}}/profile/me
Authorization: Bearer {{authToken}}
Accept: application/json

########################################
### Membership Module - List Members (Admin gated)
########################################
# @name listMembers
GET {{baseUrl}}/members
Authorization: Bearer {{authToken}}
Accept: application/json

########################################
### Teams Module - List Teams (Admin gated)
########################################
# @name listTeams
GET {{baseUrl}}/teams
Authorization: Bearer {{authToken}}
Accept: application/json

########################################
### Teams Module - List Sectors (Admin gated)
########################################
# @name listSectors
GET {{baseUrl}}/sectors
Authorization: Bearer {{authToken}}
Accept: application/json